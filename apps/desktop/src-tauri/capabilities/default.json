{
  "identifier": "shell",
  "description": "Menu-bar shell. The Web UI is loaded from the loopback daemon and may open the full window.",
  "windows": ["panel", "main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "allow-open-main-window",
    "allow-quit",
    "allow-quit-now",
    "allow-open-local-path",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
