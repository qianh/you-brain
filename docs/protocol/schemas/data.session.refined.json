{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fileId": {
      "minLength": 1,
      "type": "string"
    },
    "refinedUpTo": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "sessionKey": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "sessionKey",
    "fileId",
    "source",
    "title",
    "summary",
    "refinedUpTo"
  ],
  "type": "object"
}
