{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digestConclusions": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 60,
          "type": "array"
        },
        "incomplete": {
          "const": true,
          "type": "boolean"
        },
        "total": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ids",
        "total"
      ],
      "type": "object"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "reminderId": {
      "minLength": 1,
      "type": "string"
    },
    "sessionKey": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    },
    "topicId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reminderId",
    "kind",
    "topicId",
    "text"
  ],
  "type": "object"
}
