{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appVersion": {
      "minLength": 1,
      "type": "string"
    },
    "capabilities": {
      "items": {
        "enum": [
          "capture",
          "refine",
          "consolidate"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "deviceId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "desktop",
        "server",
        "virtual"
      ],
      "type": "string"
    },
    "lastActiveAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "lastSeenAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "platform": {
      "enum": [
        "darwin",
        "linux",
        "bot"
      ],
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "deviceId",
    "displayName",
    "kind",
    "platform",
    "appVersion",
    "protocolVersion",
    "capabilities",
    "lastSeenAt",
    "lastActiveAt"
  ],
  "type": "object"
}
