{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conclusionId": {
      "minLength": 1,
      "type": "string"
    },
    "sessionKey": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    },
    "topicId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "conclusionId",
    "topicId",
    "text",
    "sessionKey"
  ],
  "type": "object"
}
