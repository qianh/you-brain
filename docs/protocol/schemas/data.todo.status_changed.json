{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "by": {
      "enum": [
        "auto",
        "user"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "done",
        "dropped"
      ],
      "type": "string"
    },
    "todoId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "todoId",
    "status",
    "by"
  ],
  "type": "object"
}
