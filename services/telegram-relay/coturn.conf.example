# U-Brain 远程桌面 coturn 示例配置（可选：用于跨对称 NAT / 企业防火墙 / 蜂窝网络兜底）
#
# 1. 在中转 VPS 上安装 coturn：
#    Ubuntu/Debian: sudo apt update && sudo apt install -y coturn
# 2. 生成一个至少 32 字节的随机密钥（例如 `openssl rand -hex 32`），填入下方 static-auth-secret，
#    并在 U-Brain 中转服务的环境变量中配置相同的密钥：
#      RELAY_TURN_URLS="turn:你的VPS域名或公网IP:3478?transport=udp,turn:你的VPS域名或公网IP:3478?transport=tcp"
#      RELAY_TURN_SECRET="<同一个随机密钥>"
# 3. 放行防火墙端口：3478/udp、3478/tcp 及 49152-65535/udp。

listening-port=3478
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_OPENSSL_RAND_HEX_32
realm=you-brain.local
total-quota=100
bps-capacity=0
stale-nonce=600
no-multicast-peers
no-cli
no-loopback-peers

# 安全防护：禁止通过 TURN 中继探测 VPS 本机回环与内网网段
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
