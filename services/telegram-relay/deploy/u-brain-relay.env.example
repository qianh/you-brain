# 复制为 /etc/u-brain-relay.env 后再填值。
# 权限必须是 0600，属主为 root 或运行用户 u-brain-relay，不要给其他用户读。
#   sudo install -m 0600 -o root -g u-brain-relay deploy/u-brain-relay.env.example /etc/u-brain-relay.env
# 真实的 Token 和密钥只写在这个文件里。不要写进命令行参数、shell 历史或聊天。

# 可选：@BotFather 给的 Bot Token。留空则以纯设备中转与原生推送模式运行（不请求 api.telegram.org）。
BOT_TOKEN=

# 设备连接密钥（过渡期）与管理密钥，至少 16 位。在服务器上生成后写到下一行，例如 openssl rand -hex 24 的输出。
RELAY_KEY=

# 过渡期是否继续允许用共享密钥 RELAY_KEY 连接 /connect 与 /check（默认 true）。
# 全部设备通过邀请码入网后设为 false，此后 RELAY_KEY 仅用于 Telegram webhook 校验和本机管理端点。
RELAY_ACCEPT_LEGACY_KEY=true

# 对外的固定地址（经 cloudflared 等隧道时必填，不含路径）。设置后 webhook 一律注册为 <此地址>/telegram
# RELAY_PUBLIC_ORIGIN=https://relay.example.com

# 只听本机，由反代或隧道转出去
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# systemd 的 StateDirectory=u-brain-relay 会创建这个目录
RELAY_DATA_DIR=/var/lib/u-brain-relay

# 路由设备（通常是 VPS 上 daemon 的 deviceId）：手机上不引用的消息先交给它，按内容判断是回哪条推送；不设则转给最近推送过的设备。
# RELAY_ROUTER_DEVICE=
